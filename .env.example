# Copied from web3auth-examples/quick-starts/nextjs-quick-start.
# Demo Sapphire Devnet project. Get your own at https://dashboard.web3auth.io
#
# This shared project is capped at 1000 devnet logins per UTC month and its
# chain list is 0x1, 0xaa36a7, 0xe708, 0x4cef52 with smart accounts enabled.
# Arbitrum One is absent from both, which is why lib/web3auth.ts has to declare
# the chain and its account abstraction bundler by hand. Your own project should
# add Arbitrum One on the dashboard instead.
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=BHgArYmWwSeq21czpcarYh0EVq2WWOzflX-NTK-tY1-1pauPzHKRRLgpABkmYiIV_og9jAvoIxQ8L3Smrwe04Lw

# Same demo Client ID, used when NEXT_PUBLIC_WEB3AUTH_CLIENT_ID is unset and
# the resolved network is devnet (local + Vercel preview).
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID_DEVNET=BHgArYmWwSeq21czpcarYh0EVq2WWOzflX-NTK-tY1-1pauPzHKRRLgpABkmYiIV_og9jAvoIxQ8L3Smrwe04Lw

# web3auth-examples does not publish a Sapphire Mainnet Client ID.
# Create a mainnet project at https://dashboard.web3auth.io and set this on Vercel Production.
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID_MAINNET=

# Optional override: "devnet" or "mainnet".
# Official examples always use Sapphire Devnet. Leave unset to resolve from
# NEXT_PUBLIC_VERCEL_ENV (mainnet only when that is "production").
# NEXT_PUBLIC_WEB3AUTH_NETWORK=devnet

# Optional ERC-20 collateral shown by the terminal. Defaults to native USDC on
# Arbitrum One. This is a public contract address, not a secret.
# NEXT_PUBLIC_COLLATERAL_TOKEN_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# Set automatically by Vercel. Do not set this locally.
# NEXT_PUBLIC_VERCEL_ENV=production
